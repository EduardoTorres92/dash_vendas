{
  "name": "dash-vendas-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Versão web (estática) do dashboard de faturamento, publicada na Netlify",
  "scripts": {
    "dados": "python3 ../scripts/exportar_dados.py",
    "dados:paridade": "python3 ../scripts/exportar_dados.py --paridade",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
